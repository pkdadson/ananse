{
  "name": "canvas-lib",
  "private": true,
  "version": "0.1.0",
  "description": "Modern, design-forward canvas library for hierarchies and flows.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "test": "pnpm -r --filter='./packages/*' test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:demo": "pnpm --filter=demo dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
