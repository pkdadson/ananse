{
  "name": "@ananse/tokens",
  "version": "0.1.0",
  "description": "CSS variables and Tailwind preset for the Ananse design system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkdadson/ananse.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/pkdadson/ananse#readme",
