{
  "name": "@canvas/core",
  "version": "0.1.0",
  "description": "Framework-agnostic types, layout, schemas, data adapters, and edit mutations for Canvas org charts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "keywords": ["org-chart", "hierarchy", "dagre", "hr", "typescript", "canvas"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
