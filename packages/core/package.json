{
  "name": "@ananse/core",
  "version": "0.1.0",
  "description": "Framework-agnostic types, layout, schemas, data adapters, and edit mutations for Ananse org charts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkdadson/ananse.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pkdadson/ananse#readme",
  "bugs": "https://github.com/pkdadson/ananse/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "keywords": ["org-chart", "hierarchy", "dagre", "hr", "typescript", "ananse"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
